NEON_DATABASE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
NEON_DATABASE_USERNAME=your_neon_role
NEON_DATABASE_PASSWORD=replace-with-neon-role-password
NEON_CONNECTION_TIMEOUT=10000
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=change-this-reviewer-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_LIFETIME=PT8H
DEMO_DATA_ENABLED=false
DEMO_CUSTOMER_USERNAME=demo.customer
DEMO_CUSTOMER_PASSWORD=DemoCustomer123!
FLYWAY_ENABLED=false
BACKEND_PORT=8080
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_API_BASE_URL=http://localhost:8080
POLICY_STORAGE_DIR=/var/lib/lending/policies
APPLICATION_STORAGE_DIR=/var/lib/lending/applications
APPLICATION_MAX_FILE_SIZE=10MB
POLICY_MAX_FILE_SIZE=20MB
POLICY_MAX_REQUEST_SIZE=21MB
POLICY_MAX_PAGES=500
POLICY_MAX_EXTRACTED_CHARACTERS=10000000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OCR_PROVIDER=ocr-space
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OCR_PROVIDER_TIMEOUT=20s
AI_PROVIDER_TIMEOUT=20s
POLICY_CHUNK_SIZE=1200
POLICY_CHUNK_OVERLAP=150
POLICY_RETRIEVAL_TOP_K=5
POLICY_MINIMUM_SIMILARITY=0.25
